{
  "layer": "top",
  "position": "left",
  "width": 36,
  "margin": 4,
  "modules-left": [
    "group/cpu-stack",
    "group/mem-stack"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "tray",
    "backlight",
    "pulseaudio",
    "hyprland/language",
    "custom/bluetooth",
    "network",
    "battery",
    "power-profiles-daemon",
    "clock"
  ],
  "group/cpu-stack": {
    "orientation": "inherit",
    "modules": [
      "cpu",
      "temperature"
    ]
  },
  "group/mem-stack": {
    "orientation": "inherit",
    "modules": [
      "memory"
    ]
  },
  "cpu": {
    "interval": 5,
    "format": "<span color='#cc1515'></span>\n{usage}%",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "justify": "center"
  },
  "temperature": {
    "interval": 5,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 90,
    "format": "{temperatureC}°C",
    "justify": "center"
  },
  "memory": {
    "interval": 5,
    "format": "<span color='#cc1515'></span>\n{percentage}%\n{used:0.0f}G",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
    "states": {
      "warning": 75,
      "critical": 90
    },
    "justify": "center"
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "tooltip": false,
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "󰎈",
      "5": "",
      "6": "󰏜",
      "7": ""
    }
  },
  "tray": {
    "icon-size": 16,
    "spacing": 16
  },
  "backlight": {
    "format": "{icon}",
    "tooltip-format": "Brightness {percent}%",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "tooltip-format": "Volume {volume}%",
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },
  "hyprland/language": {
    "format": "{}",
    "format-en": "EN",
    "format-uk": "UA"
  },
  "custom/bluetooth": {
    "exec": "~/.local/bin/wofi-bluetooth --status",
    "interval": 5,
    "on-click": "~/.local/bin/wofi-bluetooth"
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-linked": "",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}"
  },
  "battery": {
    "format": "{icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": "{capacity}% · {timeTo}",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "clock": {
    "format": "{:%H\n%M}",
    "format-alt": "{:%Y-%m-%d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "justify": "center"
  }
}
