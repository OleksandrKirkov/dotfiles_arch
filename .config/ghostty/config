# =========================
# 🪟 WINDOW
# =========================
window-decoration = none
window-padding-x = 8
window-padding-y = 8
click-repeat-interval = 500
minimum-contrast = 1.2

# =========================
# 🖋️ FONT
# =========================
font-family = JetBrainsMono Nerd Font
font-style = Regular
font-size = 14

# =========================
# 🎨 COLORS
# =========================
# Palette comes from the active theme (themes/<name>/ghostty), set by theme-switch
theme = /home/oleksandr/.local/state/theme/current/ghostty

# =========================
# ⌨️ KEYBINDINGS
# =========================
keybind = ctrl+shift+f11=toggle_fullscreen

# Leave these to tmux: Alt+1..9 jump to tmux windows, Ctrl+Enter reaches the program
# (alt+N and alt+digit_N are separate default triggers, both go)
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind
keybind = alt+digit_1=unbind
keybind = alt+digit_2=unbind
keybind = alt+digit_3=unbind
keybind = alt+digit_4=unbind
keybind = alt+digit_5=unbind
keybind = alt+digit_6=unbind
keybind = alt+digit_7=unbind
keybind = alt+digit_8=unbind
keybind = ctrl+enter=unbind

# =========================
# 🐚 SHELL
# =========================
# Attach to the "main" tmux session, creating it on first launch
command = /usr/bin/tmux new-session -A -s main

# =========================
# 🌿 ENVIRONMENT
# =========================
env = TERM=xterm-256color

background-image = /home/oleksandr/Pictures/Wallpapers/1395941.jpgg
background-image-fit = cover
background-image-position = center
background-image-opacity = 0.01

app-notifications = no-clipboard-copy
