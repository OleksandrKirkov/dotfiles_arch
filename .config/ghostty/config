# =========================
# 🪟 WINDOW
# =========================
window-decoration = none
window-padding-x = 8
window-padding-y = 8
click-repeat-interval = 500
minimum-contrast = 1.2

# =========================
# 🖋️ FONT
# =========================
font-family = JetBrainsMono Nerd Font
font-style = Regular
font-size = 14

# =========================
# 🎨 COLORS (minimal, clean)
# =========================
# background = 282828
background = 0B0E14
foreground = ffffff
cursor-color = c0caf5
selection-foreground = 1a1b26
selection-background = c0caf5

# 16 базових кольорів
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

# =========================
# ⌨️ KEYBINDINGS
# =========================
keybind = ctrl+shift+f11=toggle_fullscreen

# =========================
# 🐚 SHELL
# =========================
command = zsh

# =========================
# 🌿 ENVIRONMENT
# =========================
env = TERM=xterm-256color

background-image = /home/oleksandr/Pictures/Wallpapers/1395941.jpgg
background-image-fit = cover
background-image-position = center
background-image-opacity = 0.01

app-notifications = no-clipboard-copy
