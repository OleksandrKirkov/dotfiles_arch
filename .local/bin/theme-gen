#!/usr/bin/env -S nvim -l
-- theme-gen: build a system theme package from an NvChad base46 theme.
--
-- Usage: theme-gen <base46-name> <out-dir> [wallpaper]
--
-- Reads the palette from base46 (or a custom theme in ~/.config/nvim/lua/themes/)
-- and writes: theme.env hypr.lua waybar.css ghostty btop.theme hyprlock.conf nvim
-- Terminal colours use the theme's named base_30 colours, so red is red in every theme
-- (base46's own term.lua maps base_16 slots, which puts e.g. teal in the red slot for tokyonight).

local name, out, wallpaper = arg[1], arg[2], arg[3] or ""
if not name or not out then
    io.stderr:write("usage: theme-gen <base46-name> <out-dir> [wallpaper]\n")
    os.exit(2)
end

local data = vim.fn.stdpath("data")
local config = vim.fn.stdpath("config")
package.path = table.concat({
    data .. "/lazy/base46/lua/?.lua",
    config .. "/lua/?.lua",
    package.path,
}, ";")

-- base46 theme files call require("base46").override_theme(); the real module needs NvChad loaded.
package.loaded["base46"] = { override_theme = function(t) return t end }
-- A few themes read UI settings (telescope style, transparency); colours do not depend on them.
local function stub()
    return setmetatable({}, { __index = function(t, k) local v = stub(); rawset(t, k, v); return v end })
end
local nvconfig = stub()
nvconfig.base46.transparency = false
package.loaded["nvconfig"] = nvconfig

local ok, theme = pcall(require, "base46.themes." .. name)
if not ok then ok, theme = pcall(require, "themes." .. name) end
if not ok or type(theme) ~= "table" or not theme.base_30 or not theme.base_16 then
    io.stderr:write("theme-gen: no base46 theme named '" .. name .. "'\n")
    os.exit(1)
end

local c, b = theme.base_30, theme.base_16

-- Not every theme defines every base_30 colour: fill gaps from close relatives.
local fallback = {
    one_bg = { "black2", "darker_black" }, one_bg2 = { "one_bg", "black2" }, one_bg3 = { "one_bg2" },
    grey_fg = { "grey", "light_grey" }, line = { "one_bg2", "grey" },
    baby_pink = { "pink", "red" }, pink = { "baby_pink", "red" },
    vibrant_green = { "green" }, sun = { "yellow" }, nord_blue = { "blue" },
    cyan = { "teal", "blue" }, teal = { "cyan", "green" }, purple = { "dark_purple", "pink" },
    yellow = { "sun", "orange" },
}
for key, alternatives in pairs(fallback) do
    if not c[key] then
        for _, alt in ipairs(alternatives) do
            if c[alt] then c[key] = c[alt]; break end
        end
    end
end
for _, key in ipairs({ "white", "black", "red", "green", "blue", "yellow", "purple", "cyan", "one_bg", "one_bg2", "grey_fg", "line" }) do
    if not c[key] then
        io.stderr:write("theme-gen: theme '" .. name .. "' has no base_30." .. key .. "\n")
        os.exit(1)
    end
end
local function hex(v) return (v:gsub("^#", ""):lower()) end
local function rgba(v, alpha)
    local h = hex(v)
    return string.format("rgba(%d, %d, %d, %s)",
        tonumber(h:sub(1, 2), 16), tonumber(h:sub(3, 4), 16), tonumber(h:sub(5, 6), 16), alpha)
end

local accent = c.blue

local function write(file, text)
    local f = assert(io.open(out .. "/" .. file, "w"))
    f:write(text)
    f:close()
end

vim.fn.mkdir(out, "p")

write("nvim", name .. "\n")

write("theme.env", string.format([[
# Generated by theme-gen from base46 theme '%s'. Edit freely.
wallpaper="%s"
]], name, wallpaper))

write("hypr.lua", string.format([[
return {
    active_border   = "rgba(%sff)",
    inactive_border = "rgba(%saa)",
}
]], hex(accent), hex(c.one_bg2)))

write("waybar.css", table.concat({
    "@define-color bg " .. c.black .. ";",
    "@define-color accent " .. accent .. ";",
    "@define-color accent_dim " .. c.one_bg2 .. ";",
    "@define-color text " .. c.white .. ";",
    "@define-color muted " .. c.grey_fg .. ";",
    "@define-color line " .. rgba(accent, "0.27") .. ";",
    "@define-color stat_line " .. rgba(accent, "0.65") .. ";",
    "",
}, "\n"))

local term = {
    c.one_bg, c.red, c.green, c.yellow, c.blue, c.purple, c.cyan, b.base05,
    c.grey_fg, c.baby_pink, c.vibrant_green, c.sun, c.nord_blue, c.pink, c.teal, c.white,
}
local g = {
    "# Generated by theme-gen from base46 theme '" .. name .. "'.",
    "background = " .. hex(b.base00),
    "foreground = " .. hex(b.base05),
    "cursor-color = " .. hex(c.white),
    "selection-background = " .. hex(c.one_bg2),
    "selection-foreground = " .. hex(c.white),
}
for i, color in ipairs(term) do
    g[#g + 1] = string.format("palette = %d=#%s", i - 1, hex(color))
end
write("ghostty", table.concat(g, "\n") .. "\n")

local function q(v) return '"' .. v .. '"' end
local bt = {
    main_bg = c.black, main_fg = c.white, title = c.white, hi_fg = accent,
    selected_bg = accent, selected_fg = c.black, inactive_fg = c.grey_fg,
    graph_text = c.grey_fg, meter_bg = c.one_bg, proc_misc = c.cyan,
    cpu_box = c.one_bg2, mem_box = c.one_bg2, net_box = c.one_bg2, proc_box = c.one_bg2,
    div_line = c.line,
    temp_start = c.green, temp_mid = c.yellow, temp_end = c.red,
    cpu_start = c.blue, cpu_mid = c.purple, cpu_end = c.red,
    free_start = c.green, cached_start = c.cyan, available_start = c.green,
    used_start = c.red, download_start = c.blue, upload_start = c.purple,
}
local order = {
    "main_bg", "main_fg", "title", "hi_fg", "selected_bg", "selected_fg", "inactive_fg",
    "graph_text", "meter_bg", "proc_misc", "cpu_box", "mem_box", "net_box", "proc_box",
    "div_line", "temp_start", "temp_mid", "temp_end", "cpu_start", "cpu_mid", "cpu_end",
    "free_start", "cached_start", "available_start", "used_start", "download_start", "upload_start",
}
local lines = { "# Generated by theme-gen from base46 theme '" .. name .. "'." }
for _, k in ipairs(order) do
    lines[#lines + 1] = string.format("theme[%s]=%s", k, q(bt[k]))
end
write("btop.theme", table.concat(lines, "\n") .. "\n")

write("hyprlock.conf", string.format([[
$wallpaper = %s
$text   = rgba(%sff)
$accent = rgba(%see)
$check  = rgba(%see)
$fail   = rgba(%see)
]], wallpaper, hex(c.white), hex(accent), hex(c.green), hex(c.red)))

print("theme-gen: wrote " .. out)
