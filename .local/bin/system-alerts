#!/usr/bin/env bash
# system-alerts: desktop notifications for low battery and high RAM usage.
#
# Polls sysfs and /proc/meminfo; fires one critical notification per threshold
# crossing and re-arms once the value recovers. Started from hyprland.lua.
#
# Env overrides:
#   BATTERY_LOW_PERCENT   notify when discharging below this (default 10)
#   RAM_HIGH_GB           notify when used RAM exceeds this many GB, 10^9 bytes (default 28)
#   ALERT_INTERVAL        poll interval in seconds (default 30)

set -u

BATTERY_LOW_PERCENT="${BATTERY_LOW_PERCENT:-10}"
RAM_HIGH_GB="${RAM_HIGH_GB:-28}"
ALERT_INTERVAL="${ALERT_INTERVAL:-30}"

# Single instance per session.
lock="${XDG_RUNTIME_DIR:-/tmp}/system-alerts.lock"
exec 9>"$lock"
flock -n 9 || exit 0

battery_dir=""
for dir in /sys/class/power_supply/BAT*; do
    [ -r "$dir/capacity" ] && battery_dir="$dir" && break
done

battery_alerted=0
ram_alerted=0

check_battery() {
    [ -n "$battery_dir" ] || return 0
    local capacity status
    capacity=$(<"$battery_dir/capacity")
    status=$(<"$battery_dir/status")

    if [ "$status" = "Discharging" ] && [ "$capacity" -lt "$BATTERY_LOW_PERCENT" ]; then
        if [ "$battery_alerted" -eq 0 ]; then
            notify-send -u critical -a system-alerts -i battery-caution \
                "Low battery" "${capacity}% left. Plug in the charger."
            battery_alerted=1
        fi
    else
        battery_alerted=0
    fi
}

check_ram() {
    local total available used_kib limit_kib
    total=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
    available=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
    used_kib=$((total - available))
    limit_kib=$((RAM_HIGH_GB * 1000000000 / 1024))

    if [ "$used_kib" -gt "$limit_kib" ]; then
        if [ "$ram_alerted" -eq 0 ]; then
            local used_gb
            used_gb=$(awk -v k="$used_kib" 'BEGIN { printf "%.1f", k * 1024 / 1e9 }')
            notify-send -u critical -a system-alerts -i dialog-warning \
                "High RAM usage" "${used_gb} GB in use (limit ${RAM_HIGH_GB} GB)."
            ram_alerted=1
        fi
    else
        ram_alerted=0
    fi
}

while :; do
    check_battery
    check_ram
    sleep "$ALERT_INTERVAL"
done
