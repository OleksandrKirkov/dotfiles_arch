#!/usr/bin/env bash
# theme-switch: switch the desktop theme with an animated wallpaper transition.
#
# Themes are folders under <dotfiles>/themes/<name>/ containing:
#   theme.env      shell vars (wallpaper=...)
#   hypr.lua       Hyprland border colours
#   waybar.css     @define-color palette imported by waybar/style.css
#   rofi.rasi      colour variables imported by rofi/theme.rasi
#   dunst.conf     dunst drop-in, linked to ~/.config/dunst/dunstrc.d/90-theme.conf
#   ghostty        Ghostty theme file
#   btop.theme     btop theme
#   hyprlock.conf  hyprlock colour variables
#   nvim           NvChad base46 theme name
#
# Any NvChad base46 theme can be picked: the first time, theme-gen builds its
# package from nvim's palette into themes/<name>/.
#
# The active theme is a symlink: ${XDG_STATE_HOME:-~/.local/state}/theme/current

set -euo pipefail

SELF_DIR="$(dirname "$(readlink -f "$0")")"
# The repo root is the nearest ancestor holding themes/ (this script lives in
# modules/theme/home/.local/bin/).
REPO="$SELF_DIR"
until [[ -d "$REPO/themes" ]]; do
    [[ "$REPO" != / ]] || { echo "theme-switch: no themes/ above $SELF_DIR" >&2; exit 1; }
    REPO="$(dirname "$REPO")"
done
THEMES="$REPO/themes"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/theme"
CURRENT="$STATE/current"
DURATION="${THEME_SWITCH_DURATION:-1.2}"
NVIM_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/nvim"
BASE46_THEMES="${XDG_DATA_HOME:-$HOME/.local/share}/nvim/lazy/base46/lua/base46/themes"

usage() {
    cat <<EOF
Usage: theme-switch <name> | --pick | --next | --apply | --list [--all] | --current

  <name>       Switch to a theme (any base46 theme is generated on first use)
  --pick       Choose from all themes with rofi
  --next       Switch to the next installed theme alphabetically
  --apply      Re-apply the current theme (e.g. after login)
  --list       List installed themes (themes/<name>/); --all adds every base46 theme
  --current    Print the active theme
EOF
}

die() { echo "theme-switch: $*" >&2; exit 1; }

list_themes() {
    find "$THEMES" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort
}

# Installed packages plus every dark base46 theme and custom NvChad theme.
# Light themes (M.type = "light") are left out.
all_themes() {
    local d f
    {
        list_themes
        for d in "$BASE46_THEMES" "$NVIM_CONFIG/lua/themes"; do
            [[ -d "$d" ]] || continue
            for f in "$d"/*.lua; do
                grep -qE '^M\.type *= *"light"' "$f" || basename "$f" .lua
            done
        done
    } | sort -u
}

# theme.env is shared by every user: keep a wallpaper in this home as a literal
# $HOME (it expands when theme.env is sourced) instead of this user's path.
unexpand_home() { printf '%s\n' "${1/#"$HOME"\//\$HOME/}"; }

# Build themes/<name>/ from nvim's palette, inheriting the current wallpaper.
generate_theme() {
    local name="$1" wallpaper=""
    if [[ -f "$CURRENT/theme.env" ]]; then
        # shellcheck source=/dev/null
        wallpaper="$(source "$CURRENT/theme.env"; echo "${wallpaper:-}")"
    fi
    "$SELF_DIR/theme-gen" "$name" "$THEMES/$name" "$(unexpand_home "$wallpaper")"
}

# Themes built before a new app was themed lack its file: generate the missing
# files only, never overwriting what is already there (hand-made themes stay as is).
backfill_theme() {
    local dir="$1" name wallpaper="" tmp f missing=0
    for f in theme.env hypr.lua waybar.css rofi.rasi dunst.conf ghostty btop.theme hyprlock.conf; do
        [[ -e "$dir/$f" ]] || missing=1
    done
    (( missing )) || return 0
    name="$(head -n1 "$dir/nvim" 2>/dev/null)" || return 0
    [[ -n "$name" ]] || return 0
    if [[ -f "$dir/theme.env" ]]; then
        # shellcheck source=/dev/null
        wallpaper="$(source "$dir/theme.env"; echo "${wallpaper:-}")"
    fi
    tmp="$(mktemp -d)"
    if "$SELF_DIR/theme-gen" "$name" "$tmp" "$(unexpand_home "$wallpaper")" >/dev/null; then
        for f in "$tmp"/*; do
            [[ -e "$dir/${f##*/}" ]] || cp -- "$f" "$dir/"
        done
    fi
    rm -rf -- "$tmp"
}

pick_theme() {
    command -v rofi >/dev/null || die "rofi is not installed"
    rofi -dmenu -i -p Theme -select "$(current_theme)"
}

# Recolour every running nvim; if none is running, rebuild the base46 cache so the
# next nvim starts in the new theme.
apply_nvim() {
    local name="$1" sock reloaded=0
    command -v nvim >/dev/null || return 0
    [[ -n "$name" ]] || return 0
    for sock in "${XDG_RUNTIME_DIR:-/tmp}"/nvim.*; do
        [[ -S "$sock" ]] || continue
        if timeout 3 nvim --server "$sock" --remote-expr \
            "luaeval('pcall(require(\"nvchad.themes.utils\").reload_theme, \"$name\")')" >/dev/null 2>&1; then
            reloaded=1
        fi
    done
    if (( ! reloaded )); then
        (timeout 20 nvim --headless "+lua pcall(function() require('base46').load_all_highlights() end)" +qa \
            >/dev/null 2>&1 &)
    fi
}

current_theme() {
    if [[ -L "$CURRENT" ]]; then basename "$(readlink "$CURRENT")"; fi
}

next_theme() {
    local cur first="" found=0 t
    cur="$(current_theme)"
    while read -r t; do
        [[ -z "$first" ]] && first="$t"
        if (( found )); then echo "$t"; return; fi
        [[ "$t" == "$cur" ]] && found=1
    done < <(list_themes)
    echo "$first"
}

# Grow the new wallpaper from the cursor on its monitor; other monitors grow
# from the point on their edge nearest to the cursor.
apply_wallpaper() {
    local wallpaper="$1"
    [[ -f "$wallpaper" ]] || { echo "theme-switch: wallpaper not found: $wallpaper" >&2; return 0; }
    command -v awww >/dev/null || { echo "theme-switch: awww not installed, skipping wallpaper" >&2; return 0; }
    [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || return 0

    if ! awww query >/dev/null 2>&1; then
        awww-daemon >/dev/null 2>&1 &
        for _ in $(seq 20); do awww query >/dev/null 2>&1 && break; sleep 0.1; done
    fi

    local cx cy
    read -r cx cy < <(hyprctl cursorpos | tr -d ',')

    local name x y w h scale fps px py pids=()
    while read -r name x y w h scale fps; do
        px=$(awk -v c="$cx" -v o="$x" -v s="$scale" -v w="$w" \
            'BEGIN { p = int((c - o) * s); if (p < 0) p = 0; if (p > w - 1) p = w - 1; print p }')
        py=$(awk -v c="$cy" -v o="$y" -v s="$scale" -v h="$h" \
            'BEGIN { p = int((c - o) * s); if (p < 0) p = 0; if (p > h - 1) p = h - 1; print h - 1 - p }')
        awww img -o "$name" "$wallpaper" \
            --transition-type grow \
            --transition-pos "$px,$py" \
            --transition-duration "$DURATION" \
            --transition-fps "$fps" &
        pids+=("$!")
    done < <(hyprctl monitors -j | jq -r \
        '.[] | "\(.name) \(.x) \(.y) \(.width) \(.height) \(.scale) \([.refreshRate | round, 255] | min)"')

    wait "${pids[@]}" 2>/dev/null || true
}

# Hyprland animates the border colour change itself.
apply_hyprland() {
    [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] || return 0
    hyprctl eval "
        local t = dofile('$CURRENT/hypr.lua')
        hl.config({ general = { col = {
            active_border = t.active_border,
            inactive_border = t.inactive_border,
        } } })" >/dev/null || echo "theme-switch: hyprctl eval failed" >&2
}

reload_apps() {
    pkill -USR2 -x waybar 2>/dev/null || true   # waybar: SIGUSR2 reloads config and style
    pkill -USR2 -x ghostty 2>/dev/null || true  # ghostty (GTK): SIGUSR2 reloads config
    if pgrep -x dunst >/dev/null; then                # dunst: re-read dunstrc and dunstrc.d
        dunstctl reload 2>/dev/null || true
    fi
}

link_btop() {
    mkdir -p "$HOME/.config/btop/themes"
    ln -sfn "$CURRENT/btop.theme" "$HOME/.config/btop/themes/current.theme"
}

# Tell the desktop tools through the dotctl bus (docs/bus.md, topic "theme").
# Best effort: without a running dotctld the switch still completes.
publish_theme() {
    command -v dotctl >/dev/null || return 0
    dotctl bus publish theme "$(jq -cn --arg name "$1" --arg wallpaper "$2" '{name: $name, wallpaper: $wallpaper}')" \
        2>/dev/null || true
}

# hyprlock: $wallpaper is per user (a path in $HOME), so it is not in the shared
# theme package; write it next to the current-theme link.
write_hyprlock_wallpaper() {
    # shellcheck disable=SC2016 # $wallpaper is a literal hyprlang variable
    printf '# Written by theme-switch from the active theme'"'"'s theme.env.\n$wallpaper = %s\n' "$1" \
        >"$STATE/hyprlock-wallpaper.conf"
}

# dunst reads every file in dunstrc.d/; 90-theme.conf follows the active theme.
link_dunst() {
    mkdir -p "$HOME/.config/dunst/dunstrc.d"
    ln -sfn "$CURRENT/dunst.conf" "$HOME/.config/dunst/dunstrc.d/90-theme.conf"
}

name=""
case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --list)    if [[ "${2:-}" == "--all" ]]; then all_themes; else list_themes; fi; exit 0 ;;
    --current) current_theme; exit 0 ;;
    --pick)    name="$(all_themes | pick_theme)" || exit 0 ;;
    --next)    name="$(next_theme)" ;;
    --apply)   name="$(current_theme)"; [[ -n "$name" ]] || name="$(list_themes | head -n1)" ;;
    "")        usage >&2; exit 2 ;;
    -*)        usage >&2; exit 2 ;;
    *)         name="$1" ;;
esac

[[ -n "$name" ]] || exit 0
[[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid theme name: $name"
if [[ ! -d "$THEMES/$name" ]]; then
    all_themes | grep -qx -- "$name" || die "no such theme: $name (see --list --all)"
    generate_theme "$name" >/dev/null || die "could not generate theme: $name"
fi
backfill_theme "$THEMES/$name"

mkdir -p "$STATE"
ln -sfn "$THEMES/$name" "$CURRENT"
link_btop
link_dunst

wallpaper=""
# shellcheck source=/dev/null
source "$CURRENT/theme.env"

nvim_theme=""
[[ -f "$CURRENT/nvim" ]] && nvim_theme="$(head -n1 "$CURRENT/nvim")"

write_hyprlock_wallpaper "$wallpaper"
apply_hyprland
reload_apps
apply_nvim "$nvim_theme"
apply_wallpaper "$wallpaper"
publish_theme "$name" "$wallpaper"

command -v notify-send >/dev/null && notify-send -a theme-switch -t 1500 "Theme" "$name" || true
