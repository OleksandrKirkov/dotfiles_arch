for f in \
  "$RAW/dev/git-global.txt" \
  "$RAW/dotfiles/repo.txt"
do
  [[ -f "$f" ]] || continue

  tmp="${f}.tmp"

  redact_stream < "$f" > "$tmp"

  mv "$tmp" "$f"
done

sort \
  -u \
  -o "$OMITTED" \
  "$OMITTED"

log "Building Markdown report..."

count_lines() {
  if [[ -f "$1" ]]; then
    grep -vc '^$' "$1" 2>/dev/null || echo 0
  else
    echo 0
  fi
}

count_snapshot() {
  find "$SNAPSHOT" \
    \( -type f -o -type l \) \
    2>/dev/null |
    wc -l |
    tr -d ' '
}

PACMAN_EXPLICIT="$(
  count_lines "$RAW/packages/pacman-explicit.txt"
)"

PACMAN_AUR="$(
  count_lines "$RAW/packages/pacman-explicit-foreign-aur.txt"
)"

PACMAN_ORPHANS="$(
  count_lines "$RAW/packages/pacman-orphans.txt"
)"

MODIFIED_BACKUPS="$(
  count_lines "$RAW/packages/pacman-modified-backups.txt"
)"

ETC_UNOWNED="$(
  count_lines "$RAW/packages/etc-unowned.txt"
)"

SNAPSHOT_COUNT="$(
  count_snapshot
)"

OMITTED_COUNT="$(
  count_lines "$OMITTED"
)"

cat > "$REPORT" <<EOF
# System configuration audit

Generated: **$(date --iso-8601=seconds)**  
Host: **$HOST**  
User: **$USER**  
Script: **$PROGRAM $VERSION**

> This is an inventory/snapshot, not a claim that every listed file was manually edited. The most useful manual-change signals are modified pacman backup files, unowned files under \`/etc\`, custom systemd units, scripts under user/\`/usr/local\` paths, and your XDG/Hyprland configuration.

## Summary

| Item | Count |
|---|---:|
| Explicit pacman packages | $PACMAN_EXPLICIT |
| Explicit foreign/AUR packages | $PACMAN_AUR |
| Pacman orphans | $PACMAN_ORPHANS |
| Modified pacman backup files | $MODIFIED_BACKUPS |
| Unowned files/symlinks under /etc | $ETC_UNOWNED |
| Files/symlinks copied into safe snapshot | $SNAPSHOT_COUNT |
| Sensitive paths omitted | $OMITTED_COUNT |

## Start here: likely manual changes

1. [Modified pacman backup files](raw/packages/pacman-modified-backups.txt) — package-owned config files whose backup copy differs from the packaged baseline.
2. [Unowned /etc files](raw/packages/etc-unowned.txt) — strong candidates for administrator-created configuration; review generated files too.
3. [User-enabled systemd units](raw/systemd/user-enabled.txt) and [system-enabled units](raw/systemd/system-enabled.txt).
4. [Home symlinks](raw/files/home-symlinks.txt) — useful for reconstructing GNU Stow/chezmoi/manual symlink layouts.
5. [XDG config tree](raw/files/config-tree.txt) — newest files are listed first.
6. [Local scripts](raw/files/local-bin.txt) — user scripts and files under /usr/local/bin/sbin.
7. [Snapshot manifest](manifest.tsv) — exact source path, snapshot destination, size, SHA-256 and mtime.
8. [Sensitive files omitted](sensitive-omitted.txt) — review these manually instead of blindly committing them to dotfiles.

