capture_shell \
  files/config-tree.txt \
  'find "${XDG_CONFIG_HOME:-$HOME/.config}" -xdev -maxdepth 3 \( -type f -o -type l \) -printf "%TY-%Tm-%Td %TH:%TM %s %p -> %l\n" 2>/dev/null | sort -r'

capture_shell \
  files/local-share-applications.txt \
  'find "$HOME/.local/share/applications" -maxdepth 2 \( -type f -o -type l \) -printf "%p -> %l\n" 2>/dev/null | sort || true'

capture_shell \
  files/local-bin.txt \
  'find "$HOME/.local/bin" "$HOME/bin" /usr/local/bin /usr/local/sbin -maxdepth 2 \( -type f -o -type l \) -printf "%m %u:%g %TY-%Tm-%Td %TH:%TM %p -> %l\n" 2>/dev/null | sort || true'

if [[ -n "$DOTFILES_DIR" ]]; then
  DOTFILES_DIR="$(
    readlink -f "$DOTFILES_DIR" 2>/dev/null ||
      printf '%s' "$DOTFILES_DIR"
  )"

  capture_shell \
    dotfiles/repo.txt \
    "printf 'dotfiles_dir=%q\n' '$DOTFILES_DIR'; git -C '$DOTFILES_DIR' status --short --branch 2>/dev/null || true; echo; git -C '$DOTFILES_DIR' remote -v 2>/dev/null | sed -E 's#(https?://)[^/@[:space:]]+:[^/@[:space:]]+@#\1***:***@#g' || true"

  capture_shell \
    dotfiles/symlinks-into-repo.txt \
    "find '$HOME' -xdev -maxdepth 6 -type l -print0 2>/dev/null | while IFS= read -r -d '' p; do t=\$(readlink -f \"\$p\" 2>/dev/null || true); case \"\$t\" in '$DOTFILES_DIR'/*) printf '%s -> %s\n' \"\$p\" \"\$t\";; esac; done | sort"
fi

log "Copying safe configuration snapshot..."

