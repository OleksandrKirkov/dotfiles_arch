      grep -E "^(XDG_|WAYLAND_|DISPLAY=|HYPR|GDK_|GTK_|QT_|SDL_|MOZ_|ELECTRON_|BROWSER=|EDITOR=|VISUAL=|TERMINAL=|LANG=|LC_|PATH=|SSH_AUTH_SOCK=)" |
