#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

PROGRAM="system-config-audit"
VERSION="1.0.0"

FULL=0
INCLUDE_SENSITIVE=0
USE_SUDO=1
DOTFILES_DIR=""
OUTPUT_BASE="${HOME}/system-config-audits"
MAX_COPY_MB=10

usage() {
  cat <<'EOF'
Usage: system-config-audit [options]

Options:
  --full                  Run slower package integrity checks (pacman -Qkk).
  --include-sensitive     Include files that may contain credentials/tokens/keys.
                          DO NOT commit the resulting snapshot to a public repo.
  --no-sudo               Do not ask for sudo; skip privileged collection.
  --dotfiles PATH         Record Git/status/symlink information for an old dotfiles repo.
  --output DIR            Base output directory (default: ~/system-config-audits).
  --max-copy-mb N         Skip regular files larger than N MiB (default: 10).
  -h, --help              Show help.
EOF
}

while (($#)); do
  case "$1" in
    --full)
      FULL=1
      shift
      ;;
    --include-sensitive)
      INCLUDE_SENSITIVE=1
      shift
      ;;
    --no-sudo)
      USE_SUDO=0
      shift
      ;;
    --dotfiles)
      [[ $# -ge 2 ]] || {
        echo "Missing value for --dotfiles" >&2
        exit 2
      }
      DOTFILES_DIR="$2"
      shift 2
      ;;
    --output)
      [[ $# -ge 2 ]] || {
        echo "Missing value for --output" >&2
        exit 2
      }
      OUTPUT_BASE="$2"
      shift 2
      ;;
    --max-copy-mb)
      [[ $# -ge 2 && "$2" =~ ^[0-9]+$ && "$2" -gt 0 ]] || {
        echo "--max-copy-mb expects a positive integer" >&2
        exit 2
      }
      MAX_COPY_MB="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ ${EUID} -eq 0 ]]; then
  echo "Do not run this script with sudo/root. Run it as your normal desktop user." >&2
  exit 1
fi

umask 077

STAMP="$(date +%Y%m%d-%H%M%S)"
HOST="$(hostname 2>/dev/null || echo unknown-host)"

OUT="${OUTPUT_BASE%/}/${HOST}-${STAMP}"
RAW="$OUT/raw"
SNAPSHOT="$OUT/snapshot"
REPORT="$OUT/REPORT.md"
MANIFEST="$OUT/manifest.tsv"
OMITTED="$OUT/sensitive-omitted.txt"
ERRORS="$OUT/errors.log"

mkdir -p "$RAW" "$SNAPSHOT"

: > "$MANIFEST"
: > "$OMITTED"
: > "$ERRORS"

printf 'source\tdestination\ttype\tsize_bytes\tsha256\tmtime\n' > "$MANIFEST"

log() {
  printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"
}

warn() {
  printf '[WARN] %s\n' "$*" | tee -a "$ERRORS" >&2
}

have() {
  command -v "$1" >/dev/null 2>&1
}

SUDO=()

if (( USE_SUDO )); then
  if have sudo; then
    log "Requesting sudo once for privileged read-only inventory..."

    if sudo -v; then
      SUDO=(sudo)
    else
      warn "sudo authentication failed; continuing without privileged reads"
      USE_SUDO=0
    fi
  else
    warn "sudo is not installed; continuing without privileged reads"
    USE_SUDO=0
  fi
fi

capture() {
  local rel="$1"
  shift

  local dst="$RAW/$rel"

  mkdir -p "$(dirname "$dst")"

  {
    printf '$'
    printf ' %q' "$@"
    printf '\n\n'

    "$@"
  } >"$dst" 2>&1 || true
}

capture_shell() {
  local rel="$1"
  shift

  local cmd="$*"
  local dst="$RAW/$rel"

  mkdir -p "$(dirname "$dst")"

  {
    printf '$ %s\n\n' "$cmd"
    bash -o pipefail -c "$cmd"
  } >"$dst" 2>&1 || true
}

capture_sudo_shell() {
  local rel="$1"
  shift

  local cmd="$*"
  local dst="$RAW/$rel"

  mkdir -p "$(dirname "$dst")"

  if (( USE_SUDO )); then
    {
      printf '$ sudo bash -o pipefail -c %q\n\n' "$cmd"
      sudo bash -o pipefail -c "$cmd"
    } >"$dst" 2>&1 || true
  else
    printf 'Skipped: sudo disabled/unavailable.\n' >"$dst"
  fi
}

is_sensitive_path() {
  local p="$1"

  case "$p" in
    */.ssh/id_*|*/.ssh/*_key|*/.ssh/*_key.pub)
      return 0
      ;;

    */.gnupg/*|*/.password-store/*|*/.local/share/keyrings/*)
      return 0
      ;;

    */.aws/credentials|*/.aws/config|*/.azure/*|*/.config/gcloud/*)
      return 0
      ;;

    */.kube/config|*/.docker/config.json|*/.config/containers/auth.json)
      return 0
      ;;

    */.npmrc|*/.pypirc|*/.netrc|*/.git-credentials|*/.cargo/credentials.toml)
      return 0
      ;;

    */.config/gh/hosts.yml|*/.config/glab-cli/config.yml|*/.config/hub)
      return 0
      ;;

    */rclone.conf|*/restic/*|*/sops/age/*|*/.config/age/*)
      return 0
      ;;

    */Bitwarden/*|*/bitwarden/*|*/1Password/*|*/KeePass*/*|*/keepass*/*)
      return 0
      ;;

    */cookies*|*/Cookies*|*/Login\ Data*|*/Web\ Data*|*/key4.db|*/logins.json)
      return 0
      ;;

    */secrets/*|*/secret/*|*/credentials/*|*/tokens/*)
      return 0
      ;;

    /etc/shadow|/etc/gshadow|/etc/shadow-*|/etc/gshadow-*)
      return 0
      ;;

    /etc/ssh/ssh_host_*_key|/etc/ssh/ssh_host_*_key.pub)
      return 0
      ;;

    /etc/NetworkManager/system-connections/*)
      return 0
      ;;

    /etc/wireguard/*|*.nmconnection|*.ovpn|*.p12|*.pfx|*.pem|*.key)
      return 0
      ;;

    /etc/pacman.d/gnupg/*)
      return 0
      ;;
  esac

  return 1
}

is_noise_path() {
  local p="$1"

  case "$p" in
    */Cache/*|*/cache/*|*/Caches/*|*/GPUCache/*|*/Code\ Cache/*|*/ShaderCache/*)
      return 0
      ;;

    */Crashpad/*|*/crash/*|*/Crash\ Reports/*|*/logs/*|*/Logs/*)
      return 0
      ;;

    */node_modules/*|*/.git/objects/*|*/.git/lfs/*)
      return 0
      ;;

    */workspaceStorage/*|*/globalStorage/*|*/History/*|*/Service\ Worker/*)
      return 0
      ;;

    */blob_storage/*|*/DawnCache/*|*/GrShaderCache/*|*/VideoDecodeStats/*)
      return 0
      ;;

    *.lock|*.log|*.journal|*.tmp|*.cache|*.db-wal|*.db-shm|*.sqlite-wal|*.sqlite-shm)
      return 0
      ;;
  esac

  return 1
}

looks_binary_or_state() {
  local p="$1"

  case "$p" in
    *.sqlite|*.sqlite3|*.db|*.mdb|*.ldb|*.bin|*.blob|*.pak|*.sock|*.pid)
      return 0
      ;;

    *.png|*.jpg|*.jpeg|*.webp|*.gif|*.ico|*.mp4|*.mkv|*.mp3|*.wav|*.pdf)
      return 0
      ;;

    *.ttf|*.otf|*.woff|*.woff2)
      return 0
      ;;
  esac

  return 1
}

manifest_add() {
  local src="$1"
  local dst="$2"

  local typ="other"
  local size=""
  local sha=""
  local mtime=""

  if [[ -L "$dst" ]]; then
    typ="symlink"

    size="$(
      readlink "$dst" 2>/dev/null |
        wc -c |
        tr -d ' '
    )"

    sha="link->$(readlink "$dst" 2>/dev/null || true)"

  elif [[ -f "$dst" ]]; then
    typ="file"

    size="$(stat -c '%s' "$dst" 2>/dev/null || echo '?')"

    sha="$(
      sha256sum "$dst" 2>/dev/null |
        awk '{print $1}' ||
        true
    )"

  elif [[ -d "$dst" ]]; then
    typ="dir"
  fi

  mtime="$(
    stat -c '%y' "$dst" 2>/dev/null |
      cut -d. -f1 ||
      true
  )"

  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$src" \
    "$dst" \
    "$typ" \
    "$size" \
    "$sha" \
    "$mtime" \
    >> "$MANIFEST"
}

copy_one() {
  local src="$1"

  [[ -e "$src" || -L "$src" ]] || return 0

  if (( ! INCLUDE_SENSITIVE )) && is_sensitive_path "$src"; then
    printf '%s\n' "$src" >> "$OMITTED"
    return 0
  fi

  is_noise_path "$src" && return 0

  if [[ -f "$src" && ! -L "$src" ]]; then
    looks_binary_or_state "$src" && return 0

    local size

    size="$(stat -c '%s' "$src" 2>/dev/null || echo 0)"

    if [[ "$size" =~ ^[0-9]+$ ]] &&
      (( size > MAX_COPY_MB * 1024 * 1024 )); then
      return 0
    fi
  fi

  local dst="$SNAPSHOT$src"

  mkdir -p "$(dirname "$dst")"

  if [[ -L "$src" ]]; then
    cp \
      -a \
      --no-dereference \
      -- \
      "$src" \
      "$dst" \
      2>>"$ERRORS" || true

  elif [[ -r "$src" ]]; then
    cp \
      -a \
      -- \
      "$src" \
      "$dst" \
      2>>"$ERRORS" || true

  elif (( USE_SUDO )); then
    sudo cp \
      -a \
      -- \
      "$src" \
      "$dst" \
      2>>"$ERRORS" || return 0

    sudo chown \
      "$(id -u):$(id -g)" \
      "$dst" \
      2>>"$ERRORS" || true
  else
    return 0
  fi

  if [[ -e "$dst" || -L "$dst" ]]; then
    manifest_add "$src" "$dst"
  fi
}

copy_tree_filtered() {
  local root="$1"

  [[ -d "$root" ]] || return 0

  if [[ -r "$root" && -x "$root" ]]; then
    while IFS= read -r -d '' item; do
      copy_one "$item"
    done < <(
      find "$root" \
        -xdev \
        \( -type f -o -type l \) \
        -print0 \
        2>>"$ERRORS"
    )

  elif (( USE_SUDO )); then
    while IFS= read -r -d '' item; do
      copy_one "$item"
    done < <(
      sudo find "$root" \
        -xdev \
        \( -type f -o -type l \) \
        -print0 \
        2>>"$ERRORS"
    )
  fi
}

copy_candidates() {
  local p

  for p in "$@"; do
    if [[ -d "$p" && ! -L "$p" ]]; then
      copy_tree_filtered "$p"
    else
      copy_one "$p"
    fi
  done
}

redact_stream() {
  sed -E \
    -e 's#(https?://)[^/@[:space:]]+:[^/@[:space:]]+@#\1***:***@#g' \
    -e 's#((token|password|passwd|secret|api[_-]?key|client[_-]?secret)[[:space:]]*[=:][[:space:]]*)[^[:space:]]+#\1<redacted>#Ig' \
    -e 's#(Authorization:[[:space:]]*(Bearer|Basic)[[:space:]]+)[^[:space:]]+#\1<redacted>#Ig'
}

log "Collecting base system information..."

capture \
  system/date.txt \
  date \
  --iso-8601=seconds

capture \
  system/uname.txt \
  uname \
  -a

capture \
  system/os-release.txt \
  cat \
  /etc/os-release

capture \
  system/hostnamectl.txt \
  hostnamectl

capture \
  system/localectl.txt \
  localectl

capture \
  system/timedatectl.txt \
  timedatectl

capture_shell \
  system/user.txt \
  'id; echo; getent passwd "$USER"; echo; loginctl show-user "$USER" -p Linger -p State -p Sessions 2>/dev/null || true'

capture \
  system/lscpu.txt \
  lscpu

capture_shell \
  system/memory.txt \
  'free -h; echo; swapon --show --output=NAME,TYPE,SIZE,USED,PRIO 2>/dev/null || true'

capture \
  system/lsblk.txt \
  lsblk \
  -e7 \
  -o NAME,PATH,TYPE,SIZE,FSTYPE,FSVER,LABEL,UUID,MOUNTPOINTS

capture_shell \
  system/findmnt.txt \
  'findmnt --real -o TARGET,SOURCE,FSTYPE,OPTIONS'

capture_shell \
  system/pci.txt \
  'command -v lspci >/dev/null && lspci -nnk || true'

capture_shell \
  system/usb.txt \
  'command -v lsusb >/dev/null && lsusb || true'

log "Collecting package inventory..."

if have pacman; then
  capture_shell \
    packages/pacman-explicit.txt \
    'LC_ALL=C pacman -Qqe | sort'

  capture_shell \
    packages/pacman-explicit-native.txt \
    'LC_ALL=C pacman -Qqen | sort'

  capture_shell \
    packages/pacman-explicit-foreign-aur.txt \
    'LC_ALL=C pacman -Qqem | sort'

  capture_shell \
    packages/pacman-orphans.txt \
    'LC_ALL=C pacman -Qdtq 2>/dev/null | sort || true'

  capture_shell \
    packages/pacman-all.txt \
    'LC_ALL=C pacman -Q | sort'

  capture_shell \
    packages/pacman-modified-backups.txt \
    "LC_ALL=C pacman -Qii 2>/dev/null | awk '/^\// && /\[modified\]$/ {print}' | sort -u"

  if (( FULL )); then
    capture_shell \
      packages/pacman-qkk.txt \
      'LC_ALL=C pacman -Qkk 2>&1 | grep -Ev "^warning: .*: [0-9]+ total files, 0 altered files$" || true'
  else
    printf \
      'Skipped. Re-run with --full to execute pacman -Qkk.\n' \
      > "$RAW/packages/pacman-qkk.txt"
  fi

  capture_shell \
    packages/etc-unowned.txt \
    '
      owned=$(mktemp)
      actual=$(mktemp)

      trap "rm -f $owned $actual" EXIT

      LC_ALL=C pacman -Qql 2>/dev/null |
        grep "^/etc/" |
        sed "s#/$##" |
        sort -u > "$owned"

      find /etc \
        -xdev \
        \( -type f -o -type l \) \
        -print \
        2>/dev/null |
        sort -u > "$actual"

      comm -23 "$actual" "$owned"
    '
fi

if have flatpak; then
  capture_shell \
    packages/flatpak-apps.txt \
    'flatpak list --app --columns=application,branch,origin,installation 2>/dev/null || flatpak list --app'

  capture_shell \
    packages/flatpak-overrides.txt \
    '
      echo "# Global overrides"

      flatpak override --show 2>/dev/null || true

      echo
      echo "# Per-app overrides"

      flatpak list \
        --app \
        --columns=application \
        2>/dev/null |
      while read -r app; do
        out=$(flatpak override --show "$app" 2>/dev/null || true)

        if [ -n "$out" ]; then
          echo "## $app"
          echo "$out"
          echo
        fi
      done
    '
fi

if have snap; then
  capture_shell \
    packages/snap.txt \
    'snap list 2>/dev/null || true'
fi

log "Collecting systemd state..."

capture_shell \
  systemd/system-enabled.txt \
  'systemctl list-unit-files --state=enabled --no-pager --no-legend 2>/dev/null || true'

capture_shell \
  systemd/system-running.txt \
  'systemctl list-units --type=service --state=running --no-pager --no-legend 2>/dev/null || true'

capture_shell \
  systemd/system-timers.txt \
  'systemctl list-timers --all --no-pager 2>/dev/null || true'

capture_shell \
  systemd/system-failed.txt \
  'systemctl --failed --no-pager 2>/dev/null || true'

capture_shell \
  systemd/system-default-target.txt \
  'systemctl get-default 2>/dev/null || true'

capture_shell \
  systemd/user-enabled.txt \
  'systemctl --user list-unit-files --state=enabled --no-pager --no-legend 2>/dev/null || true'

capture_shell \
  systemd/user-running.txt \
  'systemctl --user list-units --type=service --state=running --no-pager --no-legend 2>/dev/null || true'

capture_shell \
  systemd/user-timers.txt \
  'systemctl --user list-timers --all --no-pager 2>/dev/null || true'

capture_shell \
  systemd/user-failed.txt \
  'systemctl --user --failed --no-pager 2>/dev/null || true'

capture_shell \
  systemd/user-environment-names.txt \
  'systemctl --user show-environment 2>/dev/null | sed "s/=.*$/=<value omitted>/" | sort || true'

