capture_shell \
  dev/tool-versions.txt \
  '
    for c in \
      bash \
      zsh \
      fish \
      git \
      gh \
      nvim \
      vim \
      tmux \
      starship \
      direnv \
      mise \
      asdf \
      node \
      npm \
      pnpm \
      yarn \
      bun \
      deno \
      python \
      python3 \
      pip \
      pipx \
      uv \
      ruby \
      go \
      cargo \
      rustc \
      docker \
      podman \
      kubectl \
      helm \
      terraform \
      opentofu \
      ansible
    do
      if command -v "$c" >/dev/null 2>&1; then
        printf "## %s -> %s\n" "$c" "$(command -v "$c")"

        "$c" --version 2>&1 |
          head -n 3 ||
          true

        echo
      fi
    done
  '

capture_shell \
  dev/git-global.txt \
  'git config --global --show-origin --list 2>/dev/null | sed -E "s#(https?://)[^/@[:space:]]+:[^/@[:space:]]+@#\1***:***@#g" || true'

capture_shell \
  dev/npm-global.txt \
  'command -v npm >/dev/null && npm -g ls --depth=0 2>/dev/null || true'

capture_shell \
  dev/pnpm-global.txt \
  'command -v pnpm >/dev/null && pnpm list -g --depth=0 2>/dev/null || true'

