@import url("file://@HOME@/.local/state/theme/current/waybar.css");

/* Visual language adapted from Tsugumori (github.com/Aleph1-9012/Tsugumori, MIT):
   flat charcoal rail, square corners, red activity, L-corner brackets on stats.
   Layout, modules, and scripts are this repo's own (vertical left bar). */

* {
  font-family: "JetBrainsMono Nerd Font Propo", monospace;
  font-size: 14px;
  font-weight: 500;
  min-height: 0;
  border: none;
  border-radius: 0;
  padding: 0;
  margin: 0;
  text-shadow: none;
  box-shadow: none;
}

window#waybar {
  background-color: @bg;
  border-right: 1px solid alpha(@accent, 0.4);
  color: @text;
}

/* CPU and memory stacks: bracket top-left on the first row, bottom-right on the last */
#custom-cpu_icon,
#custom-memory_icon,
#cpu,
#temperature,
#memory {
  font-size: 11px;
  margin: 0 4px;
  padding: 2px 0;
  background-repeat: no-repeat;
}

/* Custom modules wrap their label in a non-expanding box (Waybar AIconLabel),
   so the label shrinks to the glyph and sits left. Stretch it to the module
   width (36px bar - 1px border - 2x4px margin); "align": 0.5 centres the text. */
#custom-cpu_icon label,
#custom-memory_icon label,
#custom-updates label {
  min-width: 27px;
}

#custom-cpu_icon,
#custom-memory_icon {
  color: @accent;
  margin-top: 8px;
  padding-top: 4px;
  background-image:
    linear-gradient(@stat_line, @stat_line),
    linear-gradient(@stat_line, @stat_line);
  background-size: 5px 1px, 1px 5px;
  background-position: left top, left top;
}

#temperature {
  color: @muted;
}

#temperature,
#memory {
  margin-bottom: 8px;
  padding-bottom: 4px;
}

#temperature {
  background-image:
    linear-gradient(@stat_line, @stat_line),
    linear-gradient(@stat_line, @stat_line);
  background-size: 5px 1px, 1px 5px;
  background-position: right bottom, right bottom;
}

#memory {
  background-image:
    linear-gradient(@stat_line, @stat_line),
    linear-gradient(@stat_line, @stat_line);
  background-size: 5px 1px, 1px 5px;
  background-position: right bottom, right bottom;
}

#cpu.warning,
#memory.warning {
  color: @muted;
}

#cpu.critical,
#memory.critical,
#temperature.critical {
  color: @accent;
}

/* Workspaces */
#workspaces {
  margin: 4px 0;
  padding: 4px 0;
  border-top: 1px solid @line;
  border-bottom: 1px solid @line;
}

#workspaces button {
  all: unset;
  min-height: 28px;
  margin: 2px 4px;
  padding: 0;
  color: @muted;
  font-size: 16px;
  transition: background-color 150ms ease, color 150ms ease;
}

#workspaces button:hover {
  background-color: alpha(@accent, 0.13);
  color: @text;
}

#workspaces button.active,
#workspaces button.active:hover {
  background-color: @accent;
  color: @bg;
}

#workspaces button.urgent:not(.active) {
  color: @accent;
}

/* Status icons */
#tray,
#backlight,
#pulseaudio,
#language,
#bluetooth,
#custom-updates,
#network,
#battery,
#power-profiles-daemon {
  padding: 3px 0;
  margin: 1px 4px;
  color: @text;
}

#pulseaudio,
#bluetooth,
#custom-updates,
#network,
#power-profiles-daemon {
  transition: background-color 150ms ease, color 150ms ease;
}

#pulseaudio:hover,
#bluetooth:hover,
#custom-updates:hover,
#network:hover,
#power-profiles-daemon:hover {
  background-color: @accent;
  color: @bg;
}

#pulseaudio.muted,
#bluetooth.off,
#bluetooth.disabled,
#custom-updates.pending,
#network.disconnected {
  color: @accent;
}

#battery.warning:not(.charging) {
  color: @accent;
}

#battery.critical:not(.charging) {
  background-color: @accent;
  color: @bg;
}

/* Clock: solid red block */
#clock {
  margin: 4px;
  padding: 8px 0;
  font-weight: 600;
  letter-spacing: 1px;
  background-color: @accent;
  color: @bg;
}

tooltip {
  background: @bg;
  border: 1px solid @line;
}

tooltip label {
  color: @text;
  padding: 6px 8px;
}
